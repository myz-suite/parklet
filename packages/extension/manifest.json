{
  "manifest_version": 3,
  "name": "ParkingLot",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "description": "ParkingLot: drive real Chrome pages via a local relay — goto, click, type, extract, screenshot, search.",
  "permissions": ["tabs", "scripting", "webNavigation", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ParkingLot",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

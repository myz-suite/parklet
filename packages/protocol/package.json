{
  "name": "@parklet/protocol",
  "version": "0.5.0",
  "description": "Parklet: Drive a real browser owned by the human user. Shared protocol (message envelope, command set, common types, validation).",
  "license": "MIT",
  "keywords": [
    "parklet",
    "browser",
    "agent",
    "protocol",
    "cdp",
    "playwright"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myz-suite/parklet.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}

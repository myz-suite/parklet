{
  "name": "@parkinglot/server",
  "version": "0.1.0",
  "private": true,
  "description": "ParkingLot relay daemon: WebSocket server for the extension, CLI + HTTP for the agent, session registry, HITL, command ledger.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pl": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@parkinglot/protocol": "workspace:*",
    "commander": "^15.0.0",
    "ws": "^8.21.3"
  }
}
